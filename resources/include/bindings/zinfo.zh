// Access with `ZInfo->`.
class ZInfo {
	// @delete
	internal ZInfo();

	// Copies the name of the specified item class into the buffer.
	//
	// If the buffer is too small, it is resized to fit.
	//
	// @param [ItemType] itemclass_id
	// @versionadded 3.0
	// @versionchanged 2.55.17 The buffer is now resized to fit if it is too small (it used to be truncated, with an error). Known as `Module->GetItemClass` in 2.55.
	// @zasm
	//   POP D2
	//   POP D3
	//   MODULEGETIC D3 D2
	internal void GetItemType(char32[] buffer, int itemclass_id);
}

internal const ZInfo ZInfo;
// @deprecated Use [ZInfo]
internal const ZInfo Module;
